# OneBun API only. Copy this file to apps/api/.env.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Server-only credentials. Never use EXPO_PUBLIC_ names for these values.
TURSO_DATABASE_URL=libsql://your-test-database.turso.io
TURSO_AUTH_TOKEN=replace-with-a-new-test-database-token
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-your-clerk-jwt-public-key\n-----END PUBLIC KEY-----"

# Keep false when using real Clerk, and always false in production.
ALLOW_DEMO_AUTH=false

# Food search. Request a free USDA key at https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=
# Open Food Facts asks clients to include an app name/version and contact.
OPEN_FOOD_FACTS_USER_AGENT="TrackMe/0.1 (your-email@example.com)"
